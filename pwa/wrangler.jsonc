// Cloudflare Workers static-assets deploy. Workers Builds runs `npm run build` and then
// `npx wrangler deploy` from this folder (dashboard "Path" = pwa). The name must match the
// Worker's name in the dashboard.
{
  "name": "naice-notes",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    // The landing page is index.html, the app app/index.html, legal pages are folders with an
    // index.html (/privacy → /privacy/ by the default auto-trailing-slash handling). Anything else
    // gets the branded 404.html. The app has no deep links of its own.
    "not_found_handling": "404-page"
  }
}
